# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# Qdrant Configuration
# For Render: Use Qdrant Cloud (free tier) - https://cloud.qdrant.io/
QDRANT_URL=https://your-qdrant-cluster-url.qdrant.io

# Qdrant API Key (if using Qdrant Cloud)
QDRANT_API_KEY=your_qdrant_api_key_here

# CORS Origin - Set to your frontend URL on Render
CORS_ORIGIN=https://devintellect-frontend.render.com

# Frontend URL for backend to communicate
FRONTEND_URL=https://devintellect-frontend.render.com

# Node Environment
NODE_ENV=production
